  skills:
  - skillName: Comet
    description: Stronger at longer range; weak to Ward and Parry.
    icon: {fileID: 1398867081139694098, guid: c4863b117343de646b65d0f58e483abd, type: 3}
    damage: 3
    range: 2/3/4
