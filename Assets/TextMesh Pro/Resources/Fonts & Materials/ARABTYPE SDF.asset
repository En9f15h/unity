    characterSetSelectionMode: 7
    characterSequence: "Arabic(ar)\r\n\u062E\u0631\u0648\u062C\r\n\u0627\u0628\u062F\u0623!\r\n\u0643\u0644\u0645\u0629
      \u0627\u0644\u0645\u0631\u0648\u0631 (\u0627\u062E\u062A\u064A\u0627\u0631\u064A)\r\n\u0627\u0633\u0645
      \u0627\u0644\u063A\u0631\u0641\u0629\r\n\u0627\u0644\u062E\u0627\u062F\u0645\r\n\u0643\u0644\u0645\u0629
      \u0627\u0644\u0645\u0631\u0648\u0631\r\n\u0627\u0644\u0627\u0633\u0645\r\n\u0642\u0627\u0626\u0645\u0629
      \u0627\u0644\u063A\u0631\u0641\r\n\u0627\u0646\u0636\u0645\u0627\u0645 \u0639\u0634\u0648\u0627\u0626\u064A\r\n\u0625\u0646\u0634\u0627\u0621
      / \u0627\u0646\u0636\u0645\u0627\u0645\r\n\u0625\u0646\u0634\u0627\u0621 \u063A\u0631\u0641\u0629\r\n\u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645
      \u0625\u0644\u0649 \u0627\u0644\u063A\u0631\u0641\u0629\r\n\u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645
      \u0627\u0644\u0639\u0634\u0648\u0627\u0626\u064A \u0644\u0644\u063A\u0631\u0641
      \u0628\u0644\u0627 \u0643\u0644\u0645\u0629 \u0645\u0631\u0648\u0631 \u0641\u0642\u0637.\r\n\u0625\u0638\u0647\u0627\u0631
      \u0627\u0644\u0627\u062E\u062A\u064A\u0627\u0631\r\n\u0627\u0644\u0645\u0638\u0647\u0631\r\n\u0627\u0633\u062A\u0641\u0632\u0627\u0632
      \u0627\u0644\u062E\u0635\u0645 \u0648\u0637\u0627\u0642\u0629 +1.\r\n\u064A\u062A\u0641\u0627\u062F\u0649
      \u0627\u0644\u0645\u0646\u062E\u0641\u0636\u0629/\u0627\u0644\u0633\u0631\u064A\u0639\u0629\u061B
      \u0636\u0631\u0631 \u0627\u0644\u062B\u0642\u064A\u0644\u0629 \u0646\u0635\u0641\u0647.\r\n\u064A\u062A\u062D\u0631\u0643
      \u0642\u0628\u0644 \u0641\u062D\u0635 \u0627\u0644\u0647\u062C\u0648\u0645\u061B
      \u0642\u062F \u064A\u062A\u0641\u0627\u062F\u0649 \u0623\u0648 \u064A\u064F\u0635\u0627\u0628.\r\n\u064A\u0643\u0634\u0641
      \u062D\u0631\u0643\u0629 \u0639\u062F\u0648 \u0648\u0627\u062D\u062F\u0629
      \u062D\u062A\u0649 \u0646\u0647\u0627\u064A\u0629 \u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629.\r\n\u0627\u0644\u0636\u0631\u0631
      -3 \u0639\u062F\u0627 \u0627\u0644\u0647\u062C\u0645\u0627\u062A \u0627\u0644\u062B\u0642\u064A\u0644\u0629.\r\n\u064A\u0646\u062A\u0642\u0644
      \u062E\u0644\u0641 \u0627\u0644\u0639\u062F\u0648 \u0648\u064A\u0633\u062A\u062F\u064A\u0631.\r\n\u064A\u062E\u062A\u0641\u064A
      \u0645\u0643\u0627\u0646\u0647 \u0644\u062A\u0641\u0627\u062F\u064A \u0627\u0644\u0647\u062C\u0645\u0627\u062A
      \u0627\u0644\u062B\u0642\u064A\u0644\u0629.\r\n\u0633\u062D\u0631 \u062B\u0642\u064A\u0644
      \u0645\u0634\u062D\u0648\u0646\u061B \u064A\u062E\u062A\u0631\u0642 \u0627\u0644\u062F\u0641\u0627\u0639
      \u0627\u0644\u062E\u0641\u064A\u0641.\r\n\u0636\u0631\u0631 \u0623\u0643\u0628\u0631
      \u0643\u0644\u0645\u0627 \u0632\u0627\u062F\u062A \u0627\u0644\u0645\u0633\u0627\u0641\u0629.\r\n\u0645\u062F\u0649
      2\u060C \u0636\u0631\u0631 \u0647\u0627\u0626\u0644 \u0648\u0645\u062E\u0627\u0637\u0631\u0629
      \u0639\u0627\u0644\u064A\u0629.\r\n\u0635\u062F \u0642\u0648\u064A\u061B \u0636\u0639\u064A\u0641
      \u0623\u0645\u0627\u0645 \u0627\u0644\u0647\u062C\u0645\u0627\u062A \u0627\u0644\u0645\u0646\u062E\u0641\u0636\u0629.\r\n\u064A\u0639\u0643\u0633
      \u0627\u0644\u0647\u062C\u0645\u0627\u062A\u061B \u0644\u0627 \u064A\u0639\u0645\u0644
      \u0636\u062F \u0627\u0644\u062B\u0642\u064A\u0644\u0629.\r\n\u0647\u062C\u0645\u0629
      \u0645\u0646\u062E\u0641\u0636\u0629 \u0636\u0639\u064A\u0641\u0629 \u062A\u0643\u0633\u0631
      \u0627\u0644\u062F\u0641\u0627\u0639.\r\n\u0636\u0631\u0631 \u0639\u0627\u0644\u064D
      \u0648\u0645\u062F\u0649 \u0628\u0639\u064A\u062F\u061B \u064A\u062D\u062A\u0627\u062C
      \u0634\u062D\u0646\u064B\u0627.\r\n\u0647\u062C\u0648\u0645 \u0633\u0631\u064A\u0639
      \u0642\u0631\u064A\u0628\u061B \u064A\u0642\u0637\u0639 \u0627\u0644\u0634\u062D\u0646.\r\n\u0645\u0628\u0627\u0631\u0632
      \u0642\u0631\u064A\u0628 \u0645\u062A\u0648\u0627\u0632\u0646 \u0628\u062F\u0641\u0627\u0639
      \u0648\u062D\u0631\u0643\u0629 \u062B\u0627\u0628\u062A\u064A\u0646.\r\n\u0633\u0627\u062D\u0631
      \u062A\u0646\u0628\u0624 \u064A\u062A\u062D\u0643\u0645 \u0628\u0627\u0644\u0645\u0633\u0627\u0641\u0629
      \u0648\u064A\u0642\u0631\u0623 \u0646\u0648\u0627\u064A\u0627 \u0627\u0644\u0639\u062F\u0648.\r\n\u0627\u0644\u063A\u0631\u0641:
      --\r\n\u0627\u0644\u063A\u0631\u0641: {0}\r\n\u0627\u0644\u0645\u0646\u0637\u0642\u0629
      \u063A\u064A\u0631 \u0645\u062A\u0627\u062D\u0629.\r\n\u062C\u0627\u0631\u064D
      \u062A\u063A\u064A\u064A\u0631 \u0627\u0644\u0645\u0646\u0637\u0642\u0629...\r\n\u0623\u0646\u062A
      \u0641\u064A \u0647\u0630\u0647 \u0627\u0644\u0645\u0646\u0637\u0642\u0629
      \u0628\u0627\u0644\u0641\u0639\u0644.\r\n\u062C\u0627\u0631\u064D \u0627\u0644\u0627\u062A\u0635\u0627\u0644...\r\n\u062A\u0639\u0630\u0631
      \u062A\u063A\u064A\u064A\u0631 \u0627\u0644\u0645\u0646\u0637\u0642\u0629.\r\n\u062A\u0645
