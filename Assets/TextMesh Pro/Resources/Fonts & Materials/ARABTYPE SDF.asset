      \u0627\u0644\u0645\u0631\u0648\u0631 \u062E\u0627\u0637\u0626\u0629.\r\n\u062A\u0639\u0630\u0631
      \u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645 \u0625\u0644\u0649 \u0627\u0644\u063A\u0631\u0641\u0629.\r\n\u0623\u062F\u062E\u0644
