    characterSetSelectionMode: 7
    characterSequence: "\u9000\u51FA\r\n\u542F\u52A8!\r\n\u5BC6\u7801\uFF08\u53EF\u9009\uFF09\r\n\u623F\u95F4\u540D\u79F0\r\n\u670D\u52A1\u5668\r\n\u5BC6\u7801\r\n\u540D\u79F0\r\n\u623F\u95F4\u5217\u8868\r\n\u968F\u673A\u52A0\u5165\r\n\u521B\u5EFA
      / \u52A0\u5165\r\n\u521B\u5EFA\u623F\u95F4\r\n\u52A0\u5165\u623F\u95F4\r\n\u968F\u673A\u52A0\u5165\u53EA\u4F1A\u8FDB\u5165\u65E0\u5BC6\u7801\u623F\u95F4\u3002\r\n\u663E\u793A\u9009\u89D2\r\n\u9020\u578B\r\n\u5632\u8BBD\u5BF9\u624B\u5E76\u83B7\u5F97+1\u80FD\u91CF\u3002\r\n\u95EA\u907F\u4E0B\u6BB5/\u5FEB\u901F\u653B\u51FB\uFF1B\u91CD\u653B\u51FB\u4F24\u5BB3\u51CF\u534A\u3002\r\n\u653B\u51FB\u5224\u5B9A\u524D\u79FB\u52A8\uFF1B\u53EF\u80FD\u95EA\u907F\uFF0C\u4E5F\u53EF\u80FD\u88AB\u51FB\u4E2D\u3002\r\n\u770B\u7A7F\u654C\u65B91\u4E2A\u884C\u52A8\u683C\uFF0C\u6301\u7EED\u81F3\u5BF9\u5C40\u7ED3\u675F\u3002\r\n\u9664\u91CD\u653B\u51FB\u5916\uFF0C\u4F24\u5BB3-3\u3002\r\n\u77AC\u79FB\u81F3\u654C\u4EBA\u8EAB\u540E\u5E76\u8F6C\u5411\u3002\r\n\u539F\u5730\u6D88\u5931\uFF0C\u95EA\u907F\u91CD\u653B\u51FB\u3002\r\n\u84C4\u529B\u91CD\u578B\u9B54\u6CD5\uFF1B\u7A7F\u900F\u8F7B\u9632\u5FA1\u3002\r\n\u8DDD\u79BB\u8D8A\u8FDC\uFF0C\u4F24\u5BB3\u8D8A\u9AD8\u3002\r\n\u5C04\u7A0B2\uFF0C\u9AD8\u4F24\u5BB3\u9AD8\u98CE\u9669\u3002\r\n\u5F3A\u529B\u683C\u6321\uFF1B\u6015\u4E0B\u6BB5\u653B\u51FB\u3002\r\n\u53CD\u5F39\u653B\u51FB\uFF1B\u5BF9\u91CD\u653B\u51FB\u65E0\u6548\u3002\r\n\u4F4E\u4F24\u5BB3\u4E0B\u6BB5\u653B\u51FB\uFF1B\u6613\u7834\u9632\u3002\r\n\u9AD8\u4F24\u5BB3\u8FDC\u8DDD\u79BB\uFF1B\u9700\u8981\u84C4\u529B\u3002\r\n\u5FEB\u901F\u8FD1\u6218\uFF1B\u53EF\u6253\u65AD\u84C4\u529B\u3002\r\n\u5747\u8861\u8FD1\u6218\uFF0C\u9632\u5FA1\u4E0E\u673A\u52A8\u7A33\u5B9A\u3002\r\n\u9884\u6D4B\u578B\u672F\u58EB\uFF0C\u63A7\u8DDD\u5E76\u770B\u7A7F\u610F\u56FE\u3002\r\n\u623F\u95F4\u6570\uFF1A--\r\n\u623F\u95F4\u6570\uFF1A{0}\r\n\u6B64\u533A\u57DF\u4E0D\u53EF\u7528\u3002\r\n\u6B63\u5728\u5207\u6362\u533A\u57DF...\r\n\u5DF2\u5728\u6B64\u533A\u57DF\u3002\r\n\u8FDE\u63A5\u4E2D...\r\n\u65E0\u6CD5\u5207\u6362\u533A\u57DF\u3002\r\n\u533A\u57DF\u5DF2\u5207\u6362\u3002\r\n\u5DF2\u8FDB\u5165\u5927\u5385\u3002\r\n\u65E0\u6CD5\u521B\u5EFA\u623F\u95F4\u3002\r\n\u5BC6\u7801\u9519\u8BEF\u3002\r\n\u65E0\u6CD5\u