    characterSetSelectionMode: 7
    characterSequence: "Hindi(hi)\r\n\u092C\u093E\u0939\u0930 \u0928\u093F\u0915\u0932\u0947\u0902\r\n\u0936\u0941\u0930\u0942
      \u0915\u0930\u0947\u0902!\r\n\u092A\u093E\u0938\u0935\u0930\u094D\u0921 (\u0935\u0948\u0915\u0932\u094D\u092A\u093F\u0915)\r\n\u0930\u0942\u092E
      \u0915\u093E \u0928\u093E\u092E\r\n\u0938\u0930\u094D\u0935\u0930\r\n\u092A\u093E\u0938\u0935\u0930\u094D\u0921\r\n\u0928\u093E\u092E\r\n\u0930\u0942\u092E
      \u0938\u0942\u091A\u0940\r\n\u0930\u0948\u0902\u0921\u092E \u091C\u0949\u0907\u0928\r\n\u092C\u0928\u093E\u090F\u0901
      / \u091C\u0941\u0921\u093C\u0947\u0902\r\n\u0930\u0942\u092E \u092C\u0928\u093E\u090F\u0901\r\n\u0930\u0942\u092E
      \u091C\u0949\u0907\u0928 \u0915\u0930\u0947\u0902\r\n\u0930\u0948\u0902\u0921\u092E
      \u091C\u0949\u0907\u0928 \u0938\u093F\u0930\u094D\u092B \u092C\u093F\u0928\u093E
      \u092A\u093E\u0938\u0935\u0930\u094D\u0921 \u0935\u093E\u0932\u0947 \u0930\u0942\u092E
      \u092E\u0947\u0902 \u0939\u094B\u0917\u093E\u0964\r\n\u091A\u092F\u0928 \u0926\u093F\u0916\u093E\u090F\u0901\r\n\u0938\u094D\u0915\u093F\u0928\r\n\u0924\u093E\u0928\u093E
      \u0926\u0947\u0902 \u0914\u0930 +1 \u090A\u0930\u094D\u091C\u093E \u092A\u093E\u090F\u0901\u0964\r\n\u0932\u094B/\u0924\u0947\u091C\u093C
      \u0939\u092E\u0932\u0947 \u091A\u0915\u092E\u093E; \u092D\u093E\u0930\u0940
      \u0928\u0941\u0915\u0938\u093E\u0928 \u0906\u0927\u093E\u0964\r\n\u0939\u092E\u0932\u0947
      \u0938\u0947 \u092A\u0939\u0932\u0947 \u091A\u0932\u0924\u093E \u0939\u0948;
      \u092C\u091A \u092D\u0940 \u0938\u0915\u0924\u093E \u0939\u0948, \u0932\u0917
      \u092D\u0940 \u0938\u0915\u0924\u093E \u0939\u0948\u0964\r\n\u0926\u0941\u0936\u094D\u092E\u0928
      \u0915\u0940 1 \u091A\u093E\u0932 \u092E\u0948\u091A \u0915\u0947 \u0905\u0902\u0924
      \u0924\u0915 \u0926\u093F\u0916\u093E\u0924\u093E \u0939\u0948\u0964\r\n\u092D\u093E\u0930\u0940
      \u0939\u092E\u0932\u0947 \u091B\u094B\u0921\u093C\u0915\u0930 \u0928\u0941\u0915\u0938\u093E\u0928
      -3\u0964\r\n\u0926\u0941\u0936\u094D\u092E\u0928 \u0915\u0947 \u092A\u0940\u091B\u0947
      \u091F\u0947\u0932\u0940\u092A\u094B\u0930\u094D\u091F \u0939\u094B\u0915\u0930
      \u092E\u0941\u0921\u093C\u0924\u093E \u0939\u0948\u0964\r\n\u091C\u0917\u0939
      \u092A\u0930 \u0917\u093E\u092F\u092C \u0939\u094B\u0915\u0930 \u092D\u093E\u0930\u0940
      \u0939\u092E\u0932\u093E \u091A\u0915\u092E\u093E \u0926\u0947\u0924\u093E
      \u0939\u0948\u0964\r\n\u091A\u093E\u0930\u094D\u091C \u092D\u093E\u0930\u0940
      \u091C\u093E\u0926\u0942; \u0939\u0932\u094D\u0915\u0940 \u0917\u093E\u0930\u094D\u0921
      \u092D\u0947\u0926\u0924\u093E \u0939\u0948\u0964\r\n\u0926\u0942\u0930\u0940
      \u091C\u093F\u0924\u0928\u0940 \u0905\u0927\u093F\u0915, \u0928\u0941\u0915\u0938\u093E\u0928
      \u0909\u0924\u0928\u093E \u0905\u0927\u093F\u0915\u0964\r\n\u0930\u0947\u0902\u091C
      2, \u092C\u0939\u0941\u0924 \u0928\u0941\u0915\u0938\u093E\u0928, \u092C\u0921\u093C\u093E
      \u091C\u094B\u0916\u093F\u092E\u0964\r\n\u092E\u091C\u092C\u0942\u0924 \u0917\u093E\u0930\u094D\u0921;
      \u0932\u094B \u0939\u092E\u0932\u094B\u0902 \u0938\u0947 \u0915\u092E\u091C\u094B\u0930\u0964\r\n\u0939\u092E\u0932\u093E
      \u0932\u094C\u091F\u093E\u0924\u093E \u0939\u0948; \u092D\u093E\u0930\u0940
      \u092A\u0930 \u092C\u0947\u0905\u0938\u0930\u0964\r\n\u0915\u092E \u0928\u0941\u0915\u0938\u093E\u0928
      \u0935\u093E\u0932\u093E \u0932\u094B \u0939\u092E\u0932\u093E; \u0917\u093E\u0930\u094D\u0921
      \u0924\u094B\u0921\u093C\u0924\u093E \u0939\u0948\u0964\r\n\u092D\u093E\u0930\u0940
      \u0928\u0941\u0915\u0938\u093E\u0928, \u0932\u0902\u092C\u0940 \u0930\u0947\u0902\u091C;
      \u091A\u093E\u0930\u094D\u091C \u091C\u0930\u0942\u0930\u0940\u0964\r\n\u0924\u0947\u091C\u093C
      \u0928\u091C\u093C\u0926\u0940\u0915\u0940 \u0939\u092E\u0932\u093E; \u091A\u093E\u0930\u094D\u091C
      \u0930\u094B\u0915\u0924\u093E \u0939\u0948\u0964\r\n\u0938\u0902\u0924\u0941\u0932\u093F\u0924
      \u0928\u091C\u093C\u0926\u0940\u0915\u0940 \u092F\u094B\u0926\u094D\u0927\u093E;
      \u092E\u091C\u092C\u0942\u0924 \u0930\u0915\u094D\u0937\u093E \u0914\u0930
      \u092E\u0942\u0935\u092E\u0947\u0902\u091F\u0964\r\n\u092D\u0935\u093F\u0937\u094D\u092F\u0935\u0915\u094D\u0924\u093E
      \u091C\u093E\u0926\u0942\u0917\u0930; \u0926\u0942\u0930\u0940 \u0928\u093F\u092F\u0902\u0924\u094D\u0930\u093F\u0924
      \u0914\u0930 \u0907\u0930\u093E\u0926\u093E \u092A\u0922\u093C\u0924\u093E
      \u0939\u0948\u0964\r\n\u0930\u0942\u092E: --\r\n\u0930\u0942\u092E: {0}\r\n\u092F\u0939
      \u0930\u0940\u091C\u0928 \u0909\u092A\u0932\u092C\u094D\u0927 \u0928\u0939\u0940\u0902
      \u0939\u0948\u0964\r\n\u0930\u0940\u091C\u0928 \u092C\u0926\u0932\u093E \u091C\u093E
      \u0930\u0939\u093E \u0939\u0948...\r\n\u0906\u092A \u092A\u0939\u0932\u0947
      \u0938\u0947 \u0907\u0938 \u0930\u0940\u091C\u0928 \u092E\u0947\u0902 \u0939\u0948\u0902\u0964\r\n\u0915\u0928\u0947\u0915\u094D\u091F
      \u0939\u094B \u0930\u0939\u093E \u0939\u0948...\r\n\u0930\u0940\u091C\u0928
      \u0928\u0939\u0940\u0902 \u092C\u0926\u0932 \u0938\u0915\u093E\u0964\r\n\u0930\u0940\u091C\u0928
      \u092C\u0926\u0932 \u0917\u092F\u093E\u0964\r\n\u0932\u0949\u092C\u0940 \u092E\u0947\u0902
      \u0936\u093E\u092E\u093F\u0932 \u0939\u094B \u0917\u090F\u0964\r\n\u0930\u0942\u092E
      \u0928\u0939\u0940\u0902 \u092C\u0928 \u0938\u0915\u093E\u0964\r\n\u0917\u0932\u0924
      \u092A\u093E\u0938\u0935\u0930\u094D\u0921\u0964\r\n\u0930\u0942\u092E \u091C\u0949\u0907\u0928
      \u0928\u0939\u0940\u0902 \u0939\u094B \u0938\u0915\u093E\u0964\r\n\u0930\u0942\u092E
      \u0915\u093E \u0928\u093E\u092E \u0926\u0930\u094D\u091C \u0915\u0930\u0947\u0902\u0964\r\n\u0915\u094B\u0908
      \u0916\u0941\u0932\u093E \u0930\u0942\u092E \u0928\u0939\u0940\u0902 \u092E\u093F\u0932\u093E\u0964\r\n\u0938\u093E\u092E\u0902\u0924\r\n\u0928\u092C\u0940\r\n"
