  - m_Id: 32341095141376
    m_Localized: Ejek lawan dan dapat +1 Energi.
    m_Metadata:
      m_Items: []
  - m_Id: 32550441242624
    m_Localized: "Hindari serangan rendah/cepat; damage berat \xBD."
    m_Metadata:
      m_Items: []
  - m_Id: 32912925577216
    m_Localized: Bergerak sebelum cek serangan; bisa menghindar atau terkena.
    m_Metadata:
      m_Items: []
  - m_Id: 33679145226240
    m_Localized: Ungkap 1 aksi lawan hingga laga berakhir.
    m_Metadata:
      m_Items: []
  - m_Id: 33971504992256
    m_Localized: Damage -3, kecuali serangan berat.
    m_Metadata:
      m_Items: []
  - m_Id: 34226413817856
    m_Localized: Teleport ke belakang lawan lalu berbalik.
    m_Metadata:
      m_Items: []
  - m_Id: 34490659164160
    m_Localized: Menghilang di tempat untuk hindari serangan berat.
    m_Metadata:
      m_Items: []
  - m_Id: 34968004513792
    m_Localized: Sihir berat ber-charge; tembus guard ringan.
    m_Metadata:
      m_Items: []
  - m_Id: 35438840303616
    m_Localized: Semakin jauh, semakin besar damage.
    m_Metadata:
      m_Items: []
  - m_Id: 35665538240512
    m_Localized: Jarak 2, damage besar, risiko tinggi.
    m_Metadata:
      m_Items: []
  - m_Id: 35848435060736
    m_Localized: Guard kuat; lemah terhadap serangan rendah.
    m_Metadata:
      m_Items: []
  - m_Id: 36180397445120
    m_Localized: Pantulkan serangan; gagal melawan serangan berat.
    m_Metadata:
      m_Items: []
  - m_Id: 36395649126400
    m_Localized: Serangan rendah, damage kecil, pecahkan guard.
    m_Metadata:
      m_Items: []
  - m_Id: 36657872818176
    m_Localized: Damage tinggi, jarak jauh; perlu charge.
    m_Metadata:
      m_Items: []
  - m_Id: 36844502568960
    m_Localized: Serangan dekat cepat; hentikan charge.
    m_Metadata:
      m_Items: []
