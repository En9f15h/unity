    m_Localized: Rejoint au hasard uniquement les salons sans mot de passe.
    m_Metadata:
      m_Items: []
  - m_Id: 29415748456448
    m_Localized: "Afficher la s\xE9lection"
    m_Metadata:
      m_Items: []
  - m_Id: 29935712129024
    m_Localized: Apparence
    m_Metadata:
      m_Items: []
  - m_Id: 32341095141376
    m_Localized: "Provoque et gagne +1 \xE9nergie."
    m_Metadata:
      m_Items: []
  - m_Id: 32550441242624
    m_Localized: "Esquive bas/rapides ; d\xE9g\xE2ts lourds \xF72."
    m_Metadata:
      m_Items: []
  - m_Id: 32912925577216
    m_Localized: "Bouge avant l\u2019attaque ; esquive ou peut \xEAtre touch\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 33679145226240
    m_Localized: "R\xE9v\xE8le 1 action ennemie jusqu\u2019\xE0 la fin."
    m_Metadata:
      m_Items: []
  - m_Id: 33971504992256
    m_Localized: "D\xE9g\xE2ts -3, sauf attaques lourdes."
    m_Metadata:
      m_Items: []
  - m_Id: 34226413817856
    m_Localized: "Se t\xE9l\xE9porte derri\xE8re l\u2019ennemi et se retourne."
    m_Metadata:
      m_Items: []
  - m_Id: 34490659164160
    m_Localized: "Dispara\xEEt sur place pour esquiver les attaques lourdes."
    m_Metadata:
      m_Items: []
  - m_Id: 34968004513792
    m_Localized: "Magie lourde charg\xE9e ; traverse la garde l\xE9g\xE8re."
    m_Metadata:
      m_Items: []
  - m_Id: 35438840303616
    m_Localized: "Plus loin = plus de d\xE9g\xE2ts."
    m_Metadata:
      m_Items: []
  - m_Id: 35665538240512
    m_Localized: "Port\xE9e 2, gros d\xE9g\xE2ts, gros risque."
    m_Metadata:
      m_Items: []
  - m_Id: 35848435060736
    m_Localized: Garde solide ; faible contre les attaques basses.
    m_Metadata:
      m_Items: []
  - m_Id: 36180397445120
    m_Localized: Renvoie les attaques ; inefficace contre les lourdes.
    m_Metadata:
      m_Items: []
  - m_Id: 36395649126400
    m_Localized: "Attaque basse, peu de d\xE9g\xE2ts, brise la garde."
    m_Metadata:
      m_Items: []
  - m_Id: 36657872818176
    m_Localized: "Gros d\xE9g\xE2ts et longue port\xE9e ; charge requise."
    m_Metadata:
      m_Items: []
  - m_Id: 36844502568960
    m_Localized: "Attaque rapide au corps \xE0 corps ; interrompt la charge."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000000
    m_Localized: "Duelliste \xE9quilibr\xE9, solide en d\xE9fense et mobile."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000001
    m_Localized: "Mage pr\xE9dictif qui contr\xF4le la distance et lit l\u2019adversaire."
    m_Metadata:
      m_Items: []
