      m_Items: []
  - m_Id: 23305515749376
    m_Localized: "\u041F\u0430\u0440\u043E\u043B\u044C (\u043D\u0435\u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E)"
    m_Metadata:
      m_Items: []
  - m_Id: 23621502029824
    m_Localized: "\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043A\u043E\u043C\u043D\u0430\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 23776011800576
    m_Localized: "\u0421\u0435\u0440\u0432\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 23933419835392
    m_Localized: "\u041F\u0430\u0440\u043E\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 24057604788224
    m_Localized: "\u0418\u043C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 24226882703360
    m_Localized: "\u0421\u043F\u0438\u0441\u043E\u043A \u043A\u043E\u043C\u043D\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 27620112388096
    m_Localized: "\u0421\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0439 \u0432\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 27769500913664
    m_Localized: "\u0421\u043E\u0437\u0434\u0430\u0442\u044C / \u0412\u043E\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 27977068630016
    m_Localized: "\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u043A\u043E\u043C\u043D\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 28113870049280
    m_Localized: "\u0412\u043E\u0439\u0442\u0438 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 28592888926208
    m_Localized: "\u0421\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0439 \u0432\u0445\u043E\u0434
      \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u044B
      \u0431\u0435\u0437 \u043F\u0430\u0440\u043E\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 29415748456448
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0432\u044B\u0431\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 29935712129024
    m_Localized: "\u041E\u0431\u043B\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 32341095141376
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u043A\u0430\u0446\u0438\u044F \u0438
      +1 \u044D\u043D\u0435\u0440\u0433\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 32550441242624
    m_Localized: "\u0423\u043A\u043B\u043E\u043D \u043E\u0442 \u043D\u0438\u0437\u043A\u0438\u0445/\u0431\u044B\u0441\u0442\u0440\u044B\u0445;
      \u0442\u044F\u0436\u0451\u043B\u044B\u0439 \u0443\u0440\u043E\u043D \xD70,5."
    m_Metadata:
      m_Items: []
  - m_Id: 32912925577216
    m_Localized: "\u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u0434\u043E \u0430\u0442\u0430\u043A\u0438;
      \u043C\u043E\u0436\u043D\u043E \u0443\u043A\u043B\u043E\u043D\u0438\u0442\u044C\u0441\u044F
      \u0438\u043B\u0438 \u043F\u043E\u043F\u0430\u0441\u0442\u044C \u043F\u043E\u0434
      \u0443\u0434\u0430\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 33679145226240
    m_Localized: "\u0420\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 1
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0432\u0440\u0430\u0433\u0430
      \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u0431\u043E\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33971504992256
    m_Localized: "\u0423\u0440\u043E\u043D -3, \u043A\u0440\u043E\u043C\u0435 \u0442\u044F\u0436\u0451\u043B\u044B\u0445
      \u0430\u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 34226413817856
    m_Localized: "\u0422\u0435\u043B\u0435\u043F\u043E\u0440\u0442 \u0437\u0430 \u0441\u043F\u0438\u043D\u0443
      \u0432\u0440\u0430\u0433\u0430 \u0438 \u0440\u0430\u0437\u0432\u043E\u0440\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 34490659164160
    m_Localized: "\u0418\u0441\u0447\u0435\u0437\u0430\u0435\u0442 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435,
      \u0443\u043A\u043B\u043E\u043D\u044F\u044F\u0441\u044C \u043E\u0442 \u0442\u044F\u0436\u0451\u043B\u044B\u0445
      \u0430\u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 34968004513792
    m_Localized: "\u0417\u0430\u0440\u044F\u0436\u0435\u043D\u043D\u0430\u044F \u0442\u044F\u0436\u0451\u043B\u0430\u044F
      \u043C\u0430\u0433\u0438\u044F; \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442
      \u043B\u0451\u0433\u043A\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35438840303616
    m_Localized: "\u0427\u0435\u043C \u0434\u0430\u043B\u044C\u0448\u0435, \u0442\u0435\u043C
      \u0432\u044B\u0448\u0435 \u0443\u0440\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 35665538240512
    m_Localized: "\u0414\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C 2, \u0432\u044B\u0441\u043E\u043A\u0438\u0439
      \u0443\u0440\u043E\u043D \u0438 \u0440\u0438\u0441\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 35848435060736
    m_Localized: "\u0421\u0438\u043B\u044C\u043D\u044B\u0439 \u0431\u043B\u043E\u043A;
      \u0441\u043B\u0430\u0431 \u043F\u0440\u043E\u0442\u0438\u0432 \u043D\u0438\u0437\u043A\u0438\u0445
      \u0430\u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 36180397445120
    m_Localized: "\u041E\u0442\u0440\u0430\u0436\u0430\u0435\u0442 \u0430\u0442\u0430\u043A\u0438;
      \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u043F\u0440\u043E\u0442\u0438\u0432
      \u0442\u044F\u0436\u0451\u043B\u044B\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 36395649126400
    m_Localized: "\u041D\u0438\u0437\u043A\u0430\u044F \u0430\u0442\u0430\u043A\u0430,
      \u043C\u0430\u043B\u044B\u0439 \u0443\u0440\u043E\u043D, \u043B\u043E\u043C\u0430\u0435\u0442
      \u0431\u043B\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 36657872818176
    m_Localized: "\u0412\u044B\u0441\u043E\u043A\u0438\u0439 \u0443\u0440\u043E\u043D
      \u0438 \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C; \u043D\u0443\u0436\u043D\u0430
      \u0437\u0430\u0440\u044F\u0434\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 36844502568960
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u0430\u044F \u0431\u043B\u0438\u0436\u043D\u044F\u044F
      \u0430\u0442\u0430\u043A\u0430; \u0441\u0431\u0438\u0432\u0430\u0435\u0442
      \u0437\u0430\u0440\u044F\u0434\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000000
    m_Localized: "\u0421\u0431\u0430\u043B\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u0431\u043E\u0435\u0446 \u0431\u043B\u0438\u0436\u043D\u0435\u0433\u043E \u0431\u043E\u044F
      \u0441 \u0445\u043E\u0440\u043E\u0448\u0435\u0439 \u0437\u0430\u0449\u0438\u0442\u043E\u0439
      \u0438 \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000001
    m_Localized: "\u041F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C,
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u044E\u0449\u0438\u0439
      \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044E \u0438 \u0447\u0438\u0442\u0430\u044E\u0449\u0438\u0439
      \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u0438\u044F \u0432\u0440\u0430\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000002
    m_Localized: "\u041A\u041E\u041C\u041D\u0410\u0422\u042B: --"
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000003
    m_Localized: "\u041A\u041E\u041C\u041D\u0410\u0422\u042B: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000004
    m_Localized: "\u0420\u0435\u0433\u0438\u043E\u043D \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000005
    m_Localized: "\u0421\u043C\u0435\u043D\u0430 \u0440\u0435\u0433\u0438\u043E\u043D\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000006
    m_Localized: "\u0412\u044B \u0443\u0436\u0435 \u0432 \u044D\u0442\u043E\u043C
      \u0440\u0435\u0433\u0438\u043E\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000007
    m_Localized: "\u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000008
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u043C\u0435\u043D\u0438\u0442\u044C
      \u0440\u0435\u0433\u0438\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000009
    m_Localized: "\u0420\u0435\u0433\u0438\u043E\u043D \u0438\u0437\u043C\u0435\u043D\u0451\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000010
    m_Localized: "\u0412\u0445\u043E\u0434 \u0432 \u043B\u043E\u0431\u0431\u0438
      \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000011
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u043E\u0437\u0434\u0430\u0442\u044C
      \u043A\u043E\u043C\u043D\u0430\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000012
    m_Localized: "\u041D\u0435\u0432\u0435\u0440\u043D\u044B\u0439 \u043F\u0430\u0440\u043E\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000013
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0432\u043E\u0439\u0442\u0438
      \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000014
    m_Localized: "\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
      \u043A\u043E\u043C\u043D\u0430\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000015
    m_Localized: "\u041D\u0435\u0442 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0445
      \u043A\u043E\u043C\u043D\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 389117774712832
    m_Localized: "\u0420\u044B\u0446\u0430\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 390464662196224
    m_Localized: "\u041F\u0440\u043E\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
