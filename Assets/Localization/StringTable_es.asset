    m_Metadata:
      m_Items: []
  - m_Id: 28113870049280
    m_Localized: Unirse a la sala
    m_Metadata:
      m_Items: []
  - m_Id: 28592888926208
    m_Localized: "Solo entra al azar en salas sin contrase\xF1a."
    m_Metadata:
      m_Items: []
  - m_Id: 29415748456448
    m_Localized: "Mostrar selecci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 29935712129024
    m_Localized: Aspecto
    m_Metadata:
      m_Items: []
  - m_Id: 32341095141376
    m_Localized: "Provoca y gana +1 de energ\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 32550441242624
    m_Localized: "Esquiva bajos/r\xE1pidos; da\xF1o pesado a la mitad."
    m_Metadata:
      m_Items: []
  - m_Id: 32912925577216
    m_Localized: "Se mueve antes del ataque; puede esquivar o recibir da\xF1o."
    m_Metadata:
      m_Items: []
  - m_Id: 33679145226240
    m_Localized: "Revela 1 acci\xF3n enemiga hasta el final."
    m_Metadata:
      m_Items: []
  - m_Id: 33971504992256
    m_Localized: "Da\xF1o -3, excepto ataques pesados."
    m_Metadata:
      m_Items: []
  - m_Id: 34226413817856
    m_Localized: "Se teletransporta detr\xE1s del rival y se gira."
    m_Metadata:
      m_Items: []
  - m_Id: 34490659164160
    m_Localized: Desaparece para esquivar ataques pesados.
    m_Metadata:
      m_Items: []
  - m_Id: 34968004513792
    m_Localized: Magia pesada cargada; atraviesa defensa ligera.
    m_Metadata:
      m_Items: []
  - m_Id: 35438840303616
    m_Localized: "M\xE1s distancia, m\xE1s da\xF1o."
    m_Metadata:
      m_Items: []
  - m_Id: 35665538240512
    m_Localized: "Alcance 2, gran da\xF1o y alto riesgo."
    m_Metadata:
      m_Items: []
  - m_Id: 35848435060736
    m_Localized: "Guardia fuerte; d\xE9bil contra ataques bajos."
    m_Metadata:
      m_Items: []
  - m_Id: 36180397445120
    m_Localized: Refleja ataques; no funciona contra pesados.
    m_Metadata:
      m_Items: []
  - m_Id: 36395649126400
    m_Localized: "Ataque bajo, poco da\xF1o, rompe guardia."
    m_Metadata:
      m_Items: []
  - m_Id: 36657872818176
    m_Localized: "Gran da\xF1o y alcance; requiere carga."
    m_Metadata:
      m_Items: []
  - m_Id: 36844502568960
    m_Localized: "Ataque r\xE1pido cercano; interrumpe cargas."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000000
    m_Localized: Duelista equilibrado con buena defensa y movilidad.
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000001
    m_Localized: Mago predictivo que controla la distancia y lee al rival.
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000002
    m_Localized: 'SALAS: --'
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000003
