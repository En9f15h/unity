    m_Metadata:
      m_Items: []
  - m_Id: 37000000000004
    m_Localized: "La regi\xF3n no est\xE1 disponible."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000005
    m_Localized: "Cambiando de regi\xF3n..."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000006
    m_Localized: "Ya est\xE1s en esta regi\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000007
    m_Localized: Conectando...
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000008
    m_Localized: "No se pudo cambiar de regi\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000009
    m_Localized: "Regi\xF3n cambiada."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000010
    m_Localized: Te uniste al lobby.
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000011
    m_Localized: No se pudo crear la sala.
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000012
    m_Localized: "Contrase\xF1a incorrecta."
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000013
    m_Localized: No se pudo unir a la sala.
    m_Metadata:
      m_Items: []
  - m_Id: 37000000000014
    m_Localized: Introduce un nombre de sala.
    m_Metadata:
      m_Items: []
